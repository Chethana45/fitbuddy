# ===========================================================================
# FitBuddy - Environment Variables Configuration
# ===========================================================================

# Google Gemini API Key (Required for live AI generation; fallback mode active if omitted)
# Supports both GEMINI_API_KEY and GOOGLE_API_KEY
GEMINI_API_KEY=
GOOGLE_API_KEY=

# AI Model Selection
# Gemini 3.1 Pro: Structured 7-day workout plan generation and feedback refinement
GEMINI_WORKOUT_MODEL=gemini-3.1-pro

# Gemini 3.8 Flash: Fast and practical goal-aligned nutrition/recovery tips
GEMINI_NUTRITION_MODEL=gemini-3.8-flash
